# Copy to .env.local for local development.
# These are the well-known local `supabase start` defaults — not secrets.
# For a hosted project, use the values from the Supabase dashboard and keep
# the service role key strictly server-side.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Alerting. All optional — unconfigured channel types fail their Test button
# with a clear message instead of breaking anything else.
# Telegram bot token from @BotFather. TELEGRAM_API_BASE is overridable for
# tests only; leave unset in production.
TELEGRAM_BOT_TOKEN=
# Bot username (without @), for building t.me/<bot>?start=… connect links.
TELEGRAM_BOT_USERNAME=
# Shared secret Telegram echoes back on webhook calls (set at setWebhook time).
TELEGRAM_WEBHOOK_SECRET=
#TELEGRAM_API_BASE=
# Email alerts via AWS SES. Custom names (not AWS_*) because Vercel reserves
# those. Scope the IAM key to ses:SendEmail on your sending identity only.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
ALERT_EMAIL_FROM="Restorable <alerts@example.com>"
# Vercel cron authenticates with this as a Bearer token (auto-set on Vercel).
CRON_SECRET=local-dev-cron-secret
# Free-for-all beta: 1 = everyone gets Pro features free, upgrade UI hidden.
BETA_MODE=1

# Used to build links in alert messages.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Analytics is Vercel Web Analytics — enabled in the Vercel dashboard
# (Project → Analytics). No env var needed; it no-ops locally.

# Stripe (test mode for development). The secret key is never committed —
# set it in .env.local. Price IDs come from the "Restorable Pro" product.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_local_dev_secret
STRIPE_PRICE_MONTHLY=price_1Tq0UKDRIaGkGoP8jlEkbNUt
STRIPE_PRICE_YEARLY=price_1Tq0ULDRIaGkGoP82SvOvCC6
